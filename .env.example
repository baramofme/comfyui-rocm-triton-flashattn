# ComfyUI ROCm Configuration
# 이 파일을 .env 로 복사하여 사용하세요: cp .env.example .env

# 이미지 설정
COMFYUI_IMAGE=comfyui-rocm
COMFYUI_VERSION=latest

# ComfyUI 포트
COMFYUI_PORT=8188

# 볼륨 마운트 경로 (호스트 경로)
COMFYUI_MODELS=/mnt/nvmedata/comfy/models
COMFYUI_CUSTOM_NODES=/mnt/nvmedata/comfy/custom_nodes
COMFYUI_OUTPUT=/mnt/nvmedata/comfy/output
COMFYUI_WORKFLOWS=/mnt/nvmedata/comfy/workflows

# 추가 ComfyUI 인자 (선택사항)
# 예: --lowvram, --highvram, --cpu
CLI_ARGS=--lowvram

# AMD GPU 특정 설정 (선택사항)
# 7900 XTX 사용시 일반적으로 불필요, 문제 발생시 uncomment
# HSA_OVERRIDE_GFX_VERSION=11.0.0
