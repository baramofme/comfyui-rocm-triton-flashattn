# ComfyUI ROCm Configuration
# 이 파일을 .env 로 복사하여 사용하세요: cp .env.example .env

# 이미지 설정
COMFYUI_IMAGE=comfyui-rocm
COMFYUI_VERSION=latest

# ComfyUI 포트
COMFYUI_PORT=8188

# 볼륨 마운트 경로 (호스트 경로)
COMFYUI_MODELS=./models
COMFYUI_CUSTOM_NODES=./custom_nodes
COMFYUI_OUTPUT=./output
COMFYUI_WORKFLOWS=./workflows

# 추가 ComfyUI 인자 (선택사항)
# - docker-compose.yml environment:의 CLI_ARGS와 병합되지 않음. 둘 중 한 곳에서만 설정할 것.
# - ROCm 7.14에서는 --disable-pinned-memory 필수 (OOM 방지)
# - 22B+ 모델 24GB VRAM에서는 --lowvram 추가 (Krea2 반복 생성 OOM 해결, 속도 무손실)
# 운영 기준값 (docker-compose.yml과 동일):
CLI_ARGS=--disable-pinned-memory --enable-manager --use-sage-attention --force-non-blocking --enable-dynamic-vram

# ============================================================
# 아래는 docker-compose.yml 의 environment: 에 직접 넣는 변수들
# ============================================================
# --- CPU thread (호스트 코어 수에 맞게 조정) ---
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4
# OPENBLAS_NUM_THREADS=4
# VECLIB_MAXIMUM_THREADS=4
# NUMEXPR_NUM_THREADS=4

# --- 단일 GPU 전용 (기본값) ---
# SDMA: single GPU에서 PCIe SDMA 가속. 듀얼 GPU면 HSA_ENABLE_SDMA=0
# HSA_ENABLE_SDMA=1

# GPU 선택: 기본값(주석) = 모든 GPU visible.
# 듀얼 GPU (ComfyUI 두 개 띄울 때):
#   instance 1: HIP_VISIBLE_DEVICES=0
#   instance 2: HIP_VISIBLE_DEVICES=1
# # HIP_VISIBLE_DEVICES=0

# --- 듀얼 GPU 안전장치 (단일에서도 무해) ---
# NCCL_P2P_DISABLE=1    # P2P 비활성화
# NCCL_IB_DISABLE=1     # InfiniBand 없으면 항상 1

# AMD GPU 특정 설정 (선택사항)
# 7900 XTX 사용시 일반적으로 불필요, 문제 발생시 uncomment
# HSA_OVERRIDE_GFX_VERSION=11.0.0
